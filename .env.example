# Copy to .env.local for local dev, and set the same in Vercel → Project → Settings → Environment Variables

# Neon Postgres connection string
DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# Single-user login PIN
APP_PIN=123456

# Long random string used to sign the session cookie
SESSION_SECRET=change-me-to-a-long-random-secret

# Optional: Gemini API key for rates sync + Target plan re-evaluate
# (browser key from Rates customizer is also accepted via x-gemini-key)
# GEMINI_API_KEY=
